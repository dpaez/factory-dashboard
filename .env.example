# Factory server base URL, without the /v1 suffix.
FACTORY_API_URL=http://127.0.0.1:7731
# Bearer token for the factory API. Must be an `act`-scoped token (reads need `read`, commands need `act`).
FACTORY_API_TOKEN=
# Optional operator name, sent as the X-Factory-On-Behalf-Of header on commands.
FACTORY_OPERATOR_NAME=
