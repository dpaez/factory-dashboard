{
	"name": "factory-dashboard",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check ./src",
		"format": "prettier --write ./src",
		"test": "pnpm run test:unit",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"api:pull": "node scripts/sync-factory-openapi.mjs",
		"api:generate": "openapi-typescript openapi/factory.openapi.json -o src/lib/factory/generated/factory-api.d.ts",
		"api:sync": "pnpm api:pull && pnpm api:generate",
		"api:check": "node scripts/check-generated-openapi.mjs",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.46.0",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/sveltekit": "^10.6.2",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.1",
		"@vitest/browser-playwright": "^4.1.8",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "1.0.0-rc.4",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"storybook": "^10.6.2",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@fontsource/roboto": "^5.3.0",
		"@tanstack/svelte-table": "^9.2.4",
		"drizzle-orm": "1.0.0-rc.4",
		"mode-watcher": "^1.1.0",
		"openapi-fetch": "^0.17.0"
	}
}
